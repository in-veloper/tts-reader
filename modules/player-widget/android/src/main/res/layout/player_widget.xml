<?xml version="1.0" encoding="utf-8"?>
<!--
  App.js 의 미니플레이어(Player.js 의 MiniPlayer)에서 딱 재생 컨트롤만 뗀 것.
  재생 상태는 네이티브가 스스로 알 수 없다 — playback.js 가 재생할 때마다
  PlayerWidgetModule.update() 로 밀어 준다. 버튼을 누르면 브로드캐스트로
  이 위젯이 받아서, 앱(JS)이 살아 있으면(백그라운드 재생 중이면 항상 살아
  있다) 이벤트로 넘겨 playback.js 의 togglePlay/next/previous 를 그대로 부른다.

  삼성 잠금화면 위젯 슬롯은 minWidth/minHeight 를 무시하고 훨씬 작은 박스를
  줄 때가 많다(메멘토 위젯에서 겪은 것과 동일) — match_parent 로 늘어나게
  두면 그 작은 박스 기준으로 여백 없이 잘린다. 그래서 바깥은 FrameLayout 으로
  두고, 실제 카드는 고정 크기로 만들어 가운데 정렬한다 — 박스가 더 크면
  카드 둘레에 여백이 남고, 더 작아도 카드 자체의 내부 여백은 항상 지켜진다.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <LinearLayout
    android:layout_width="196dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/player_widget_bg"
    android:paddingLeft="13dp"
    android:paddingRight="13dp"
    android:paddingTop="13dp"
    android:paddingBottom="13dp">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical">

      <ImageView
        android:layout_width="5dp"
        android:layout_height="5dp"
        android:layout_marginEnd="6dp"
        android:src="@drawable/player_widget_dot" />

      <TextView
        android:id="@+id/widget_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="스텝바이"
        android:textSize="9sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:textColor="#8A94A3B8"
        android:singleLine="true" />

      <!-- 반복 모드 토글. 자주 안 쓰는 조작이라 헤더에 작게 둔다 — 메인 컨트롤
           (이전/재생/다음) 을 방해하지 않으면서도 손닿는 자리에. -->
      <FrameLayout
        android:layout_width="22dp"
        android:layout_height="22dp">

        <ImageView
          android:id="@+id/btn_repeat"
          android:layout_width="22dp"
          android:layout_height="22dp"
          android:background="@drawable/player_widget_ghost_bg"
          android:padding="5dp"
          android:src="@drawable/player_widget_repeat_off"
          android:scaleType="fitCenter" />

        <TextView
          android:id="@+id/repeat_badge"
          android:layout_width="11dp"
          android:layout_height="11dp"
          android:layout_gravity="bottom|end"
          android:background="@drawable/player_widget_badge_bg"
          android:gravity="center"
          android:text="1"
          android:textSize="7sp"
          android:textStyle="bold"
          android:textColor="#FFFFFF"
          android:includeFontPadding="false"
          android:visibility="gone" />
      </FrameLayout>
    </LinearLayout>

    <!-- 재생 중인 파일이 있을 때 -->
    <LinearLayout
      android:id="@+id/widget_content"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:gravity="center">

      <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#F1F5F9"
        android:maxLines="1"
        android:ellipsize="end" />

      <TextView
        android:id="@+id/widget_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textSize="9sp"
        android:textColor="#94A3B8"
        android:maxLines="1"
        android:ellipsize="end" />

      <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
          android:id="@+id/btn_previous"
          android:layout_width="30dp"
          android:layout_height="30dp"
          android:layout_marginEnd="10dp"
          android:background="@drawable/player_widget_ghost_bg"
          android:padding="7dp"
          android:src="@android:drawable/ic_media_previous"
          android:scaleType="fitCenter" />

        <ImageView
          android:id="@+id/btn_toggle"
          android:layout_width="42dp"
          android:layout_height="42dp"
          android:background="@drawable/player_widget_play_bg"
          android:padding="11dp"
          android:src="@android:drawable/ic_media_play"
          android:scaleType="fitCenter" />

        <ImageView
          android:id="@+id/btn_next"
          android:layout_width="30dp"
          android:layout_height="30dp"
          android:layout_marginStart="10dp"
          android:background="@drawable/player_widget_ghost_bg"
          android:padding="7dp"
          android:src="@android:drawable/ic_media_next"
          android:scaleType="fitCenter" />
      </LinearLayout>
    </LinearLayout>

    <!-- 재생한 적이 없거나, 큐가 다 끝났을 때 -->
    <TextView
      android:id="@+id/widget_empty"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:gravity="center"
      android:textSize="10sp"
      android:textColor="#64748B"
      android:text="재생 중인 파일이 없습니다"
      android:visibility="gone" />
  </LinearLayout>
</FrameLayout>
