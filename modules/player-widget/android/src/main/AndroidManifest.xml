<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!--
    memento/autoconnect 위젯과 같은 이유로 여기 둔다 — 앱 매니페스트는 prebuild 가
    app.json 으로 다시 만들기 때문에 직접 넣으면 다음 prebuild 때 사라진다.
  -->
  <application>
    <!-- 앱이 꺼져 있을 때 위젯 버튼으로 화면 없이 재생을 시작하는 서비스(WidgetPlaybackService) -->
    <service
      android:name="expo.modules.playerwidget.WidgetPlaybackService"
      android:exported="false"
      android:foregroundServiceType="mediaPlayback" />

    <receiver
      android:name="expo.modules.playerwidget.PlayerWidgetProvider"
      android:exported="true"
      android:label="@string/player_widget_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        <!-- 앱을 업데이트하면 위젯이 "불러오는 중"에 멈춰 있지 않게 바로 다시 그린다 -->
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/player_widget_info" />
    </receiver>
  </application>
</manifest>
